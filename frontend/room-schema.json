{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "description": "Schema for room data in the campus application",
  "type": "object",
  "required": ["roomnumber", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (auto-generated by json-server)"
    },
    "roomnumber": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of room numbers (e.g., ['0101', '0102'])"
    },
    "title": {
      "type": "string",
      "description": "Optional title/name for the room"
    },
    "type": {
      "type": "string",
      "enum": ["lecture", "seminar", "lab", "study", "service", "kitchen", "office", "restroom", "misc", "technic"],
      "description": "Type of room"
    },
    "subtype": {
      "type": "string",
      "description": "Optional subtype (e.g., 'restroom-men', 'restroom-women')"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Person's title (e.g., 'Dr.', 'Prof.', 'Prof. Dr.')"
          },
          "firstName": {
            "type": "string",
            "description": "First name"
          },
          "lastName": {
            "type": "string",
            "description": "Last name"
          },
          "position": {
            "type": "string",
            "description": "Job title/position"
          },
          "institution": {
            "type": "string",
            "description": "Institution the person belongs to"
          },
          "links": {
            "type": "string",
            "description": "URL links (e.g., personal website, profile page)"
          }
        }
      },
      "description": "Array of people associated with the room"
    },
    "institution": {
      "type": "string",
      "description": "Institution or department name"
    },
    "otherDetails": {
      "type": "string",
      "description": "Additional information about the room"
    },
    "links": {
      "type": "string",
      "description": "URL links related to the room"
    }
  }
}
